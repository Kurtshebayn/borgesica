# borgésica — variables de entorno
#
# Copia este archivo a `.env` y completa solo lo que uses.
#
# IMPORTANTE: borgésica NO carga `.env` automáticamente. No usa python-dotenv ni
# ningún cargador equivalente: lee las variables directamente del entorno del
# proceso (os.environ). Copiar este archivo no alcanza — hay que exportar las
# variables antes de correr el comando:
#
#   bash / zsh      set -a; source .env; set +a
#   PowerShell      Get-Content .env | ForEach-Object { if ($_ -match '^([A-Z0-9_]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1], $Matches[2]) } }
#
# O exporta la clave en la misma línea del comando:
#
#   DEEPSEEK_API_KEY=... python -m borgesica run <job_id>
#
# `.env` está en .gitignore. Nunca lo agregues al repositorio, ni siquiera con
# `git add -f`: contiene claves reales y este repositorio es público.


# ---------------------------------------------------------------------------
# Claves de proveedor — define solo la del proveedor que vayas a usar
# ---------------------------------------------------------------------------

# Anthropic (claude-sonnet-5, claude-haiku-4-5, …)
ANTHROPIC_API_KEY=

# DeepSeek y cualquier otro endpoint compatible con OpenAI (OpenRouter, etc.).
# Requiere el extra: pip install -e ".[openai-compat]"
DEEPSEEK_API_KEY=

# OpenAI (gpt-5.6-luna, …). Requiere el mismo extra que DeepSeek.
OPENAI_API_KEY=


# ---------------------------------------------------------------------------
# Ollama — modelos locales, sin clave ni conexión
# ---------------------------------------------------------------------------

# Opcional. Si no se define, el adaptador usa http://localhost:11434/v1.
# Define solo host y puerto, sin esquema ni sufijo /v1.
# OLLAMA_HOST=localhost:11434


# ---------------------------------------------------------------------------
# Selección de proveedor
# ---------------------------------------------------------------------------

# Opcional. Fuerza el proveedor cuando no se pasa --provider en la CLI.
# Valores: anthropic | deepseek | openai | ollama
#
# Sin esta variable, borgésica detecta el proveedor por la primera clave
# presente, en este orden: ANTHROPIC_API_KEY → DEEPSEEK_API_KEY →
# OPENAI_API_KEY → OLLAMA_HOST. Si no hay ninguna, asume anthropic y falla con
# un mensaje que nombra la variable faltante.
#
# Importa cuando hay varias claves definidas a la vez: sin BORGESICA_PROVIDER
# siempre gana Anthropic, que es la opción más cara de la tabla de modelos.
# BORGESICA_PROVIDER=deepseek


# ---------------------------------------------------------------------------
# Solo para tests — no hacen falta para usar borgésica
# ---------------------------------------------------------------------------

# Habilita los tests de integración, que hacen llamadas reales al proveedor y
# por lo tanto cuestan dinero. Sin esto se omiten (marker `integration`).
# INTEGRATION=1

# Habilita los tests golden/eval, también con llamadas reales (marker `golden`).
# GOLDEN=1

# Modelo que actúa de juez en los tests golden. Default: claude-haiku-4-5
# JUDGE_MODEL=claude-haiku-4-5

# Modelo usado por el test de integración de Ollama. Default: llama3
# OLLAMA_MODEL=llama3
